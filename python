<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spam Checker - Proteção Multiplataforma</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkbg: '#090D16',
                        cardbg: '#141C31',
                        accent: '#4361EE',
                        accenthover: '#3A56D4'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-darkbg text-slate-100 font-sans min-h-screen flex flex-col items-center justify-between p-2 sm:p-6 transition-colors duration-300">

    <!-- Seletor de Modo de Visualização (Simulador Multiplataforma para Windows / iOS / Android) -->
    <header class="w-full max-w-4xl flex flex-wrap items-center justify-between gap-3 mb-4 bg-cardbg/80 backdrop-blur-md p-3 rounded-2xl border border-slate-800 shadow-lg">
        <div class="flex items-center gap-2">
            <div class="w-9 h-9 bg-gradient-to-tr from-blue-600 to-indigo-400 rounded-xl flex items-center justify-center shadow-md shadow-indigo-500/30">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-base font-bold tracking-tight bg-gradient-to-r from-blue-400 to-indigo-300 bg-clip-text text-transparent">Spam Checker Pro</h1>
                <p class="text-xs text-slate-400">Segurança Multiplataforma</p>
            </div>
        </div>

        <!-- Botões de Modo / Dispositivo -->
        <div class="flex items-center gap-1.5 bg-slate-900/80 p-1 rounded-xl border border-slate-800">
            <button onclick="mudarModoVisual('mobile')" id="btn-mode-mobile" class="px-3 py-1.5 text-xs font-medium rounded-lg transition-all flex items-center gap-1 bg-accent text-white shadow">
                📱 Mobile
            </button>
            <button onclick="mudarModoVisual('desktop')" id="btn-mode-desktop" class="px-3 py-1.5 text-xs font-medium rounded-lg transition-all flex items-center gap-1 text-slate-400 hover:text-white">
                💻 Windows / Desktop
            </button>
            <button onclick="alternarTemaGlobal()" id="btn-theme" class="p-1.5 text-slate-400 hover:text-white rounded-lg transition-colors ml-1" title="Alternar Tema">
                ☀️/🌙
            </button>
        </div>
    </header>

    <!-- Container do Aplicativo com Largura Dinâmica baseada no Modo Selecionado -->
    <main id="app-wrapper" class="w-full max-w-md bg-cardbg rounded-3xl shadow-2xl p-5 sm:p-6 border border-slate-800/80 flex flex-col justify-between transition-all duration-300" style="min-height: 620px;">
        
        <!-- ================= TELA DA CAPA ================= -->
        <div id="view-capa" class="flex flex-col items-center justify-center text-center flex-grow py-4">
            <div class="w-24 h-24 bg-gradient-to-tr from-blue-600 via-indigo-500 to-violet-500 rounded-3xl flex items-center justify-center shadow-xl shadow-indigo-500/20 mb-6 transform hover:scale-105 transition-transform duration-300">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </div>
            
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-wide mb-2">Proteção Antifraude</h2>
            <p class="text-slate-400 text-xs sm:text-sm max-w-xs mb-6">Detecte phishing, golpes e e-mails maliciosos em segundos com inteligência heurística local.</p>
            
            <!-- Cards de Estatísticas Rápidas -->
            <div class="grid grid-cols-3 gap-2 w-full mb-6">
                <div class="bg-slate-900/60 border border-slate-800/80 p-2.5 rounded-xl text-center">
                    <span id="stat-total" class="block text-base font-bold text-blue-400">0</span>
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider">Análises</span>
                </div>
                <div class="bg-slate-900/60 border border-slate-800/80 p-2.5 rounded-xl text-center">
                    <span id="stat-seguros" class="block text-base font-bold text-emerald-400">0</span>
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider">Seguros</span>
                </div>
                <div class="bg-slate-900/60 border border-slate-800/80 p-2.5 rounded-xl text-center">
                    <span id="stat-spams" class="block text-base font-bold text-red-400">0</span>
                    <span class="text-[10px] text-slate-400 uppercase tracking-wider">Spams</span>
                </div>
            </div>

            <!-- Botões Principais -->
            <div class="w-full space-y-2.5">
                <button onclick="mudarTela('app')" class="w-full py-3.5 bg-accent hover:bg-accenthover text-white font-semibold rounded-xl shadow-lg shadow-blue-500/20 transition-all flex items-center justify-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                    Verificar E-mail Agora
                </button>
                <div class="grid grid-cols-2 gap-2">
                    <button onclick="mudarTela('historico')" class="w-full py-3 bg-slate-800/90 hover:bg-slate-700 text-slate-300 font-medium rounded-xl border border-slate-700/80 transition-all flex items-center justify-center gap-1.5 text-xs">
                        📜 Histórico
                    </button>
                    <button onclick="mudarTela('dicas')" class="w-full py-3 bg-slate-800/90 hover:bg-slate-700 text-slate-300 font-medium rounded-xl border border-slate-700/80 transition-all flex items-center justify-center gap-1.5 text-xs">
                        💡 Dicas de Segurança
                    </button>
                </div>
                <button onclick="mudarTela('config')" class="w-full py-2.5 bg-transparent hover:bg-slate-800/50 text-slate-400 hover:text-slate-200 font-medium rounded-xl transition-all text-xs flex items-center justify-center gap-1">
                    ⚙️ Configurações & Dispositivo
                </button>
            </div>
        </div>

        <!-- ================= TELA DO VERIFICADOR (APP) ================= -->
        <div id="view-app" class="hidden flex-col flex-grow justify-between py-1">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <button onclick="mudarTela('capa')" class="text-slate-400 hover:text-white flex items-center gap-1 text-xs bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700">
                        ← Voltar
                    </button>
                    <h3 class="text-sm font-bold tracking-wide">Analisador de Conteúdo</h3>
                </div>
                
                <div class="relative mb-3">
                    <textarea id="emailTexto" rows="5" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-accent resize-none" placeholder="Cole aqui o texto do e-mail suspeito, assunto ou mensagem recebida..."></textarea>
                    <div class="absolute bottom-2.5 right-2.5 flex gap-1">
                        <button onclick="limparTexto()" class="p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white rounded-lg text-xs" title="Limpar campo">🗑️</button>
                    </div>
                </div>
                
                <button onclick="verificarSpam()" class="w-full py-3 bg-accent hover:bg-accenthover text-white font-semibold rounded-xl shadow-lg transition-all text-sm flex items-center justify-center gap-2">
                    🔍 Analisar Riscos e Ameaças
                </button>

                <div id="resultado" class="mt-3 p-3.5 rounded-xl hidden text-left text-xs sm:text-sm font-medium"></div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-800/80 flex justify-between items-center text-[11px] text-slate-500">
                <span>Motor Heurístico v2.5</span>
                <span id="device-indicator" class="text-blue-400 font-semibold">Modo: Mobile</span>
            </div>
        </div>

        <!-- ================= TELA DE HISTÓRICO ================= -->
        <div id="view-historico" class="hidden flex-col flex-grow justify-between py-1">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <button onclick="mudarTela('capa')" class="text-slate-400 hover:text-white flex items-center gap-1 text-xs bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700">
                        ← Voltar
                    </button>
                    <h3 class="text-sm font-bold tracking-wide">Histórico de Análises</h3>
                    <button onclick="limparHistorico()" class="text-red-400 hover:text-red-300 text-xs bg-red-500/10 px-2 py-1 rounded-lg border border-red-500/20">Limpar</button>
                </div>

                <div id="lista-historico" class="space-y-2.5 max-h-[360px] overflow-y-auto pr-1">
                    <!-- Preenchido via JS -->
                </div>
            </div>
            <div class="text-center text-[11px] text-slate-500 pt-3">
                Salvo localmente no seu navegador
            </div>
        </div>

        <!-- ================= TELA DE DICAS DE SEGURANÇA ================= -->
        <div id="view-dicas" class="hidden flex-col flex-grow justify-between py-1">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <button onclick="mudarTela('capa')" class="text-slate-400 hover:text-white flex items-center gap-1 text-xs bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700">
                        ← Voltar
                    </button>
                    <h3 class="text-sm font-bold tracking-wide">Guia Antifraude</h3>
                </div>

                <div class="space-y-2.5 text-left max-h-[370px] overflow-y-auto pr-1 text-xs">
                    <div class="bg-slate-900/70 p-3 rounded-xl border border-slate-800">
                        <strong class="text-blue-400 block mb-1">1. Remetentes Suspeitos</strong>
                        <p class="text-slate-400">Verifique sempre o domínio completo do e-mail (ex: @banco.com.br vs @banco-seguro-atendimento.com).</p>
                    </div>
                    <div class="bg-slate-900/70 p-3 rounded-xl border border-slate-800">
                        <strong class="text-blue-400 block mb-1">2. Senhas e Dados Pessoais</strong>
                        <p class="text-slate-400">Bancos e instituições sérias nunca solicitam senhas, tokens ou dados completos por e-mail ou SMS.</p>
                    </div>
                    <div class="bg-slate-900/70 p-3 rounded-xl border border-slate-800">
                        <strong class="text-blue-400 block mb-1">3. Senso de Urgência Falso</strong>
                        <p class="text-slate-400">Golpistas frequentemente usam termos como "Bloqueio Imediato", "Ação Urgente" ou "Perca sua conta" para gerar pânico.</p>
                    </div>
                    <div class="bg-slate-900/70 p-3 rounded-xl border border-slate-800">
                        <strong class="text-blue-400 block mb-1">4. Links Desconhecidos</strong>
                        <p class="text-slate-400">Passe o cursor sobre os links para inspecionar o destino real antes de clicar. Evite encurtadores desconhecidos.</p>
                    </div>
                </div>
            </div>
            <div class="text-center text-[11px] text-slate-500 pt-2">
                Mantenha-se sempre informado 🔒
            </div>
        </div>

        <!-- ================= TELA DE CONFIGURAÇÕES ================= -->
        <div id="view-config" class="hidden flex-col flex-grow justify-between py-1">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <button onclick="mudarTela('capa')" class="text-slate-400 hover:text-white flex items-center gap-1 text-xs bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700">
                        ← Voltar
                    </button>
                    <h3 class="text-sm font-bold tracking-wide">Configurações do App</h3>
                </div>

                <div class="space-y-3 text-left text-xs">
                    <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-800">
                        <span class="block font-semibold text-slate-300 mb-1">Plataforma Atual</span>
                        <p class="text-slate-400 text-[11px]">O layout adapta-se automaticamente para telas compactas de smartphones (Android/iOS) ou janelas amplas de computadores (Windows).</p>
                    </div>
                    <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div>
                            <span class="block font-semibold text-slate-300">Sensibilidade Heurística</span>
                            <span class="text-[10px] text-slate-500">Padrão de rigor na detecção</span>
                        </div>
                        <span class="text-[10px] bg-blue-500/20 text-blue-400 px-2 py-1 rounded font-semibold">Equilibrado</span>
                    </div>
                    <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-800 flex items-center justify-between">
                        <div>
                            <span class="block font-semibold text-slate-300">Banco de Palavras-Chave</span>
                            <span class="text-[10px] text-slate-500">Ativo (24 regras de fraude)</span>
                        </div>
                        <span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-2 py-1 rounded font-semibold">Atualizado</span>
                    </div>
                </div>
            </div>
            <div class="text-center text-[11px] text-slate-500 pt-3">
                Spam Checker Pro v2.0.4 • Windows / iOS / Android Ready
            </div>
        </div>

        <!-- Rodapé Rodapé Geral -->
        <div class="text-center text-[11px] text-slate-500 pt-3 border-t border-slate-800/80 mt-3">
            Segurança e Privacidade Garantidas 🛡️
        </div>
    </div>

    <!-- Script de Gerenciamento da Aplicação -->
    <script>
        // Inicialização de Estado e Estatísticas
        document.addEventListener('DOMContentLoaded', () => {
            atualizarEstatisticasUI();
            carregarHistoricoUI();
        });

        function mudarTela(telaId) {
            const telas = ['capa', 'app', 'historico', 'dicas', 'config'];
            telas.forEach(t => {
                const el = document.getElementById(`view-${t}`);
                if (t === telaId) {
                    el.classList.remove('hidden');
                    el.classList.add('flex');
                } else {
                    el.classList.add('hidden');
                    el.classList.remove('flex');
                }
            });
            if(telaId === 'historico') carregarHistoricoUI();
        }

        // Alternância de layout Mobile vs Windows/Desktop
        function mudarModoVisual(modo) {
            const wrapper = document.getElementById('app-wrapper');
            const btnMobile = document.getElementById('btn-mode-mobile');
            const btnDesktop = document.getElementById('btn-mode-desktop');
            const indicator = document.getElementById('device-indicator');

            if (modo === 'mobile') {
                wrapper.className = "w-full max-w-md bg-cardbg rounded-3xl shadow-2xl p-5 sm:p-6 border border-slate-800/80 flex flex-col justify-between transition-all duration-300";
                wrapper.style.minHeight = "620px";
                btnMobile.className = "px-3 py-1.5 text-xs font-medium rounded-lg transition-all flex items-center gap-1 bg-accent text-white shadow";
                btnDesktop.className = "px-3 py-1.5 text-xs font-medium rounded-lg transition-all flex items-center gap-1 text-slate-400 hover:text-white";
                if(indicator) indicator.innerText = "Modo: Mobile (iOS/Android)";
            } else {
                wrapper.className = "w-full max-w-2xl bg-cardbg rounded-2xl shadow-2xl p-8 border border-slate-800/80 flex flex-col justify-between transition-all duration-300";
                wrapper.style.minHeight = "580px";
                btnDesktop.className = "px-3 py-1.5 text-xs font-medium rounded-lg transition-all flex items-center gap-1 bg-accent text-white shadow";
                btnMobile.className = "px-3 py-1.5 text-xs font-medium rounded-lg transition-all flex items-center gap-1 text-slate-400 hover:text-white";
                if(indicator) indicator.innerText = "Modo: Windows / Desktop";
            }
        }

        function alternarTemaGlobal() {
            const htmlEl = document.documentElement;
            if (htmlEl.classList.contains('dark')) {
                htmlEl.classList.remove('dark');
            } else {
                htmlEl.classList.add('dark');
            }
        }

        function limparTexto() {
            document.getElementById("emailTexto").value = "";
            document.getElementById("resultado").classList.add('hidden');
        }

        // Motor de Análise de Spam com persistência em localStorage
        function verificarSpam() {
            const texto = document.getElementById("emailTexto").value;
            const resultado = document.getElementById("resultado");
            
            if (!texto.trim()) {
                resultado.classList.remove('hidden');
                resultado.className = "mt-3 p-3 rounded-xl text-left text-xs bg-amber-500/20 text-amber-300 border border-amber-500/30";
                resultado.innerHTML = `⚠️ Por favor, insira ou cole o texto do e-mail para iniciar a análise.`;
                return;
            }

            const textoLower = texto.toLowerCase();
            const palavrasSpam = [
                "ganhe", "dinheiro", "promoção", "oferta", "clique aqui", 
                "grátis", "urgente", "aproveite", "cartão", "pix", "prêmio", 
                "banco", "atualização", "conta bloqueada", "vencimento", "resgate"
            ];

            let score = 0;
            let motivos = [];

            palavrasSpam.forEach(palavra => {
                if (textoLower.includes(palavra)) {
                    score += 2;
                    motivos.push(`Termo de alerta: "${palavra}"`);
                }
            });

            const linksCount = (texto.match(/https?:\/\//g) || []).length;
            if (linksCount > 2) {
                score += 3;
                motivos.push(`Excesso de links externos (${linksCount})`);
            }

            const exclamacoesCount = (texto.match(/!/g) || []).length;
            if (exclamacoesCount > 3) {
                score += 2;
                motivos.push(`Excesso de pontos de exclamação`);
            }

            if (texto.trim().length > 10 && texto === texto.toUpperCase()) {
                score += 3;
                motivos.push(`Uso excessivo de letras maiúsculas (Caps Lock)`);
            }

            resultado.classList.remove('hidden');

            let statusTipo = 'seguro';
            let tituloStatus = '';
            let cssClass = '';

            if (score >= 5) {
                statusTipo = 'spam';
                cssClass = "mt-3 p-3.5 rounded-xl text-left text-xs bg-red-500/20 text-red-300 border border-red-500/30";
                tituloStatus = `🚨 ALTO RISCO DE FRAUDE / SPAM`;
            } else if (score > 0) {
                statusTipo = 'suspeito';
                cssClass = "mt-3 p-3.5 rounded-xl text-left text-xs bg-amber-500/20 text-amber-300 border border-amber-500/30";
                tituloStatus = `⚠️ POSSÍVEL SPAM / ATENÇÃO`;
            } else {
                statusTipo = 'seguro';
                cssClass = "mt-3 p-3.5 rounded-xl text-left text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/30";
                tituloStatus = `✅ E-MAIL PROVAVELMENTE SEGURO`;
            }

            resultado.className = cssClass;
            resultado.innerHTML = `
                <div class="font-bold mb-1">${tituloStatus}</div>
                <div class="text-[11px] text-slate-300 mb-1">Pontuação de risco calculada: <b>${score}</b></div>
                ${motivos.length > 0 ? `<div class="text-[10px] text-slate-400">Indicadores: ${motivos.slice(0, 3).join(' • ')}</div>` : ''}
            `;

            // Salvar no Histórico e atualizar estatísticas
            salvarHistoricoNoLocalStorage({
                data: new Date().toLocaleDateString('pt-BR') + ' ' + new Date().toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}),
                resumo: texto.substring(0, 45) + (texto.length > 45 ? '...' : ''),
                tipo: statusTipo,
                score: score
            });

            atualizarEstatisticasUI();
        }

        // Funções de Gerenciamento de Histórico e LocalStorage
        function salvarHistoricoNoLocalStorage(item) {
            let historico = JSON.parse(localStorage.getItem('spam_checker_history') || '[]');
            historico.unshift(item);
            if(historico.length > 20) historico.pop(); // Limitar a 20 itens
            localStorage.setItem('spam_checker_history', JSON.stringify(historico));

            let stats = JSON.parse(localStorage.getItem('spam_checker_stats') || '{"total":0, "seguros":0, "spams":0}');
            stats.total += 1;
            if(item.tipo === 'seguro') stats.seguros += 1;
            else stats.spams += 1;
            localStorage.setItem('spam_checker_stats', JSON.stringify(stats));
        }

        function carregarHistoricoUI() {
            const container = document.getElementById('lista-historico');
            let historico = JSON.parse(localStorage.getItem('spam_checker_history') || '[]');

            if(historico.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-slate-500 text-xs">Nenhum e-mail verificado recentemente.</div>`;
                return;
            }

            container.innerHTML = historico.map(h => {
                let badgeColor = h.tipo === 'seguro' ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30' : (h.tipo === 'spam' ? 'bg-red-500/20 text-red-400 border-red-500/30' : 'bg-amber-500/20 text-amber-400 border-amber-500/30');
                let badgeText = h.tipo === 'seguro' ? 'Seguro' : (h.tipo === 'spam' ? 'Spam' : 'Suspeito');
                return `
                    <div class="bg-slate-900/70 p-3 rounded-xl border border-slate-800 flex items-center justify-between gap-2 text-xs">
                        <div class="overflow-hidden">
                            <span class="block text-slate-200 font-medium truncate">"${h.resumo}"</span>
                            <span class="text-[10px] text-slate-500">${h.data}</span>
                        </div>
                        <span class="px-2 py-1 rounded border text-[10px] font-semibold whitespace-nowrap ${badgeColor}">${badgeText}</span>
                    </div>
                `;
            }).join('');
        }

        function limparHistorico() {
            localStorage.removeItem('spam_checker_history');
            localStorage.setItem('spam_checker_stats', JSON.stringify({total:0, seguros:0, spams:0}));
            carregarHistoricoUI();
            atualizarEstatisticasUI();
        }

        function atualizarEstatisticasUI() {
            let stats = JSON.parse(localStorage.getItem('spam_checker_stats') || '{"total":0, "seguros":0, "spams":0}');
            document.getElementById('stat-total').innerText = stats.total;
            document.getElementById('stat-seguros').innerText = stats.seguros;
            document.getElementById('stat-spams').innerText = stats.spams;
        }
    </script>
</body>
</html>
