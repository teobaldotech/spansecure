<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SpamGuard PRO</title>

<style>
:root{
 --primary:#6366f1; --danger:#ef4444; --warning:#f59e0b; --success:#22c55e;
 --bg:linear-gradient(135deg,#0f172a,#020617);
 --card:rgba(255,255,255,0.08); --border:rgba(255,255,255,0.15);
 --text:#e5e7eb;
}
*{box-sizing:border-box;font-family:Segoe UI,system-ui}
body{margin:0;min-height:100vh;background:var(--bg);display:flex;justify-content:center;align-items:center;padding:20px;color:var(--text)}
.container{width:100%;max-width:520px;background:var(--card);backdrop-filter:blur(12px);border-radius:18px;padding:24px;border:1px solid var(--border);box-shadow:0 25px 50px rgba(0,0,0,.5)}
h2{text-align:center;margin-bottom:16px}
input,textarea{width:100%;margin:6px 0 12px;padding:12px;border-radius:10px;border:1px solid var(--border);background:rgba(0,0,0,.35);color:#fff}
textarea{height:110px;resize:none}
button{width:100%;padding:12px;margin-top:6px;border:none;border-radius:10px;font-weight:600;cursor:pointer;background:linear-gradient(135deg,var(--primary),#4338ca);color:#fff}
.barra-container{height:10px;background:rgba(255,255,255,.1);border-radius:20px;margin-top:14px;overflow:hidden}
.barra{height:100%;width:0;background:var(--success);transition:.4s}
.resultado{margin-top:12px;font-size:14px}
.small-btn{background:#334155}
.info-btn{background:#0ea5e9}
</style>
</head>

<body>
<div class="container">
<h2>📧 SpamGuard PRO</h2>

<label>Remetente</label>
<input id="remetente" placeholder="promo@ofertas.xyz">

<label>Conteúdo do e-mail</label>
<textarea id="textoEmail" placeholder="Cole o texto do e-mail..."></textarea>

<button onclick="verificarSpam()">Analisar e-mail</button>
<button class="small-btn" onclick="limparHistorico()">🧹 Limpar histórico</button>
<button class="info-btn" onclick="mostrarEstatisticas()">📊 Estatísticas</button>

<div class="barra-container"><div id="barra" class="barra"></div></div>
<div id="resultado" class="resultado"></div>
</div>

<script>
const PALAVRAS_BASE={
 "ganhe dinheiro":5,"dinheiro facil":5,"voce ganhou":4,"clique aqui":3,
 "gratis":3,"urgente":2,"cartao bloqueado":5,"confirme sua senha":5
};
const ENCURTADORES=["bit.ly","tinyurl.com","goo.gl","t.co"];
const SCORE_MAX=45;

let historico=JSON.parse(localStorage.getItem("hist")||"[]");
let blacklist=JSON.parse(localStorage.getItem("black")||"[]");
let aprendidas=JSON.parse(localStorage.getItem("learn")||"{}");

function salvar(){
 localStorage.setItem("hist",JSON.stringify(historico));
 localStorage.setItem("black",JSON.stringify(blacklist));
 localStorage.setItem("learn",JSON.stringify(aprendidas));
}

function norm(t){
 return t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"")
 .replace(/[^\w\s@.:/]/g,"");
}

function links(texto,m){
 let s=0,ls=texto.match(/https?:\/\/[^\s]+/g)||[];
 ls.forEach(l=>{
  ENCURTADORES.forEach(e=>{
   if(l.includes(e)){s+=4;m.push("Link encurtado: "+e);}
  });
 });
 if(ls.length>2){s+=3;m.push("Muitos links");}
 return s;
}

function remetente(r,m){
 let s=0;
 if(!r.includes("@")){m.push("Remetente inválido");return 3;}
 let d=r.split("@")[1];
 if(blacklist.includes(d)){s+=6;m.push("Domínio na blacklist");}
 if((r.match(/\d/g)||[]).length>=4){s+=2;m.push("Muitos números");}
 return s;
}

function palavras(t,m){
 let s=0,base={...PALAVRAS_BASE,...aprendidas};
 for(let p in base){
  if(t.includes(p)){s+=base[p];m.push("Palavra: "+p);}
 }
 return s;
}

function aprender(t){
 t.split(/\s+/).filter(p=>p.length>6).forEach(p=>{
  if(!PALAVRAS_BASE[p])aprendidas[p]=(aprendidas[p]||1)+1;
 });
}

function verificarSpam(){
 const texto=document.getElementById("textoEmail").value;
 const rem=document.getElementById("remetente").value;
 const barra=document.getElementById("barra");
 const res=document.getElementById("resultado");

 if(!texto.trim()){res.textContent="Informe o texto.";return;}

 let m=[],score=0,t=norm(texto);

 score+=palavras(t,m);
 score+=links(texto,m);
 score+=remetente(rem,m);

 let pct=Math.min(100,Math.round(score/SCORE_MAX*100));
 let cor,msg;

 if(pct<30){cor="var(--success)";msg="✅ Baixo risco";}
 else if(pct<65){cor="var(--warning)";msg="⚠️ Possível spam";}
 else{cor="var(--danger)";msg="🚨 Alto risco";}

 barra.style.width=pct+"%";
 barra.style.background=cor;

 historico.push(pct);
 aprender(t);
 salvar();

 res.innerHTML=`${msg} — ${pct}%<br><br><b>Motivos:</b><br>${m.join("<br>")||"Nenhum"}<br><br><small>Análises: ${historico.length}</small>`;
}

function limparHistorico(){
 historico=[];salvar();alert("Histórico limpo!");
}

function mostrarEstatisticas(){
 if(!historico.length){alert("Sem dados.");return;}
 let media=(historico.reduce((a,b)=>a+b,0)/historico.length).toFixed(1);
 alert(`Análises: ${historico.length}\nMédia de risco: ${media}%`);
}
</script>
</body>
</html>